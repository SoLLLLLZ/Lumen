{
  "name": "lumen",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src e2e scripts .github index.html package.json tsconfig.json .prettierrc \"*.ts\" \"*.js\"",
    "format:check": "prettier --check src e2e scripts .github index.html package.json tsconfig.json .prettierrc \"*.ts\" \"*.js\"",
    "test": "vitest run --reporter=verbose",
    "test:e2e": "playwright test",
    "predev": "node scripts/copy-wasm.mjs",
    "prebuild": "node scripts/copy-wasm.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoLLLLLZ/Lumen.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/SoLLLLLZ/Lumen/issues"
  },
  "homepage": "https://github.com/SoLLLLLZ/Lumen#readme",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "private": true
}
